{
  "name": "@pfm-solutions/ngx-theme",
  "version": "0.0.0",
  "description": "Light, dark and system theme for Angular: persisted choice, live OS tracking, cross-tab sync and a no-flash init script.",
  "keywords": [
    "angular",
    "color-scheme",
    "dark-mode",
    "signals",
    "theme"
  ],
  "homepage": "https://github.com/PFM-Solutions/ngx-theme#readme",
  "bugs": {
    "url": "https://github.com/PFM-Solutions/ngx-theme/issues"
  },
  "license": "Apache-2.0",
  "author": "PFM Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PFM-Solutions/ngx-theme.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./theme-init.js": "./dist/theme-init.js",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "prepare": "vp config",
    "build": "npm run build:lib && npm run build:demo",
    "dev": "vp pack --watch",
    "lint": "vp lint",
    "format": "vp fmt . --write",
    "check": "vp check",
    "test": "vp test run",
    "test:ci": "vp test run --coverage",
    "build:lib": "vp pack",
    "build:demo": "ng build",
    "demo": "ng serve",
    "changeset": "changeset",
    "release": "sh scripts/release.sh"
  },
  "devDependencies": {
    "@angular/build": "~22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/cli": "~22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "~22.2.3",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.0.0",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2",
    "vite-plus": "1.3.0"
  },
  "peerDependencies": {
    "@angular/cdk": ">=21",
    "@angular/common": ">=21",
    "@angular/core": ">=21"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "engines": {
    "node": ">=22.14"
  },
  "packageManager": "npm@11.19.0"
}
